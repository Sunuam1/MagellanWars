# Archspace/MagellanWars Game Server Configuration
# This file should be mounted at /etc/archspace/archspace.config in the container

[Database]
Host = mysql
User = archspace
Password = archspace123
Database = Archspace2

[Game]
# Enable turn processing
StartGame = true

# Turn interval in seconds (300 = 5 minutes)
SecondPerTurn = 300

# Image server URL
ImageServerURL = http://localhost:8080/images/
ForumServerURL = http://localhost:8080/forum/

# Game parameters
CombatReturnRate = 100
MaxUser = 10000
TechRate = 1

# Minimum councils and clusters
MinAvailableCluster = 7
MinCouncilCount = 3

# Mission times (in turns)
TrainMissionTime = 12
PatrolMissionTime = 6
DispatchToAllyMissionTime = 24
ExpeditionMissionTime = 48
ReturningWithPlanetMissionTime = 24

# Black market settings
BlackMarketItemRegen = 10
BidExpireTime = 86400

# Protection and siege settings
SiegeBlockadeRestriction = true
SiegeBlockadeProtection = false
SiegeBlockadeRestrictionDuration = 600
SiegeBlockadeProtectionDuration = 600

# Admiral settings
PeriodCreateAdmiral = 100
AdmiralMilitaryBonus = 10
MaxPeriodCreateAdmiral = 500
MaxAdmirals = 20
ExtraBlackMarketAdmirals = 5

# Training settings
TrainMaxLevel = 20
FleetExpTrain = 100
AdmiralExpTrain = 50
MinAdmiralExpPrivateer = 100
MaxAdmiralExpPrivateer = 500
MaxPrivateerCapacity = 1000
AdmiralExpExpedition = 200
AdmiralExpRaid = 100
AdmiralExpRaidMultiplier = 2
AdmiralExpStation = 50
AdmiralExpPatrol = 75
AdmiralExpBattle = 150
AdmiralExpDetect = 25

# Resource multipliers
ResourceMultiplierUltraPoor = 50
ResourceMultiplierPoor = 75
ResourceMultiplierNormal = 100
ResourceMultiplierRich = 150
ResourceMultiplierUltraRich = 200
CommerceMultiplier = 100

# Action periods (in turns)
PeriodPlayerCouncilDonation = 24
PeriodPlayerBreakPact = 48
PeriodPlayerBreakAlly = 72
PeriodPlayerDeclareHostile = 24
PeriodCouncilDeclareTotalWar = 96
PeriodCouncilDeclareWar = 72
PeriodCouncilBreakPact = 48
PeriodCouncilBreakAlly = 72
PeriodCouncilImproveRelation = 24
PeriodCouncilMergingOffer = 168

# Time limits
RetireTimeLimit = 604800
AdmissionTimeLimit = 259200
FusionTimeLimit = 604800
ProtectionPlanetLossTime = 86400
ProtectionPlanetLossAmount = 5

# Council settings
CouncilIDOffset = 1000

# Honor settings
HonorIncreaseTurns = 100

# Directories for game data
BattleLogDir = /var/log/archspace/battles
CouncilMessageDir = /var/log/archspace/council
DiplomaticMessageDir = /var/log/archspace/diplomatic
EventDir = /var/log/archspace/events

# Server settings
GameServerID = 1

[Server]
Port = 5000

# Scripts
TechScript = /usr/src/app/script/tech
ProjectScript = /usr/src/app/script/project
RaceScript = /usr/src/app/script/race
ComponentScript = /usr/src/app/script/component
ShipScript = /usr/src/app/script/ship
SpyScript = /usr/src/app/script/spy
EventScript = /usr/src/app/script/event
EmpireShipDesignScript = /usr/src/app/script/empire_ship_design
ClusterNames = /usr/src/app/script/cluster
AdmiralNameScript = /usr/src/app/script/admiral_name